  - contactPhotoUrl : String
  - store : Store [1] <<FK>>
  - status : DealerStatusEnum {required} <<ENUM>>
  - createdAt : LocalDateTime {created}
  - updatedAt : LocalDateTime {updated}
  .. Contraintes ..
  {field} {unique(registrationNumber)}
  {field} {unique(email)}
}

