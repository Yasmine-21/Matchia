}

' Interfaces/front : SaaS, banque, public
class Bank <<entity>> {
  - id : Long {id, generated} <<PK>>
  - marketplace : Marketplace [0..1] <<FK>>
  - users : List<User> [0..*] <<REL>>
  - requests : List<Request> [0..*] <<REL>>
  - name : String
  - slug : String
  - email : String
  - phone : String
  - logoText : String
  - logoUrl : String
  - country : String
  - description : String
  - websiteUrl : String
