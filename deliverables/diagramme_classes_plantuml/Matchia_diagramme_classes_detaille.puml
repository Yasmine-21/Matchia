  - subscription : Subscription [0..1] <<FK>>
  - selectedStoreDetails : List<RequestStoreSelection> [0..*] <<REL>>
  - stores : List<Store> [0..*] <<REL>>
  - modules : List<Module> [0..*] <<REL>>
  - createdAt : LocalDateTime {created}
  - updatedAt : LocalDateTime {updated}
}

' Interfaces/front : session persistante
class RefreshToken <<entity>> {
  - id : Long {id, generated} <<PK>>
  - tokenHash : String {unique, required}
  - tokenId : String {unique, required}
  - tokenFamilyId : String {required}
  - user : User [1] <<FK>>
  - createdAt : Instant {required, created}
  - issuedAt : Instant {required}
  - expiresAt : Instant {required}
  - revokedAt : Instant
  - lastUsedAt : Instant
  - revokedReason : String
  - replacedByTokenHash : String
  - ipAddress : String
  - userAgent : String
  .. Opérations métier ..
  + isActive(): boolean
  .. Contraintes ..
  {field} {unique(tokenHash)}
  {field} {unique(tokenId)}
}

