class Dealer <<entity>> {
  - id : Long {id, generated} <<PK>>
  - companyName : String {required}
  - registrationNumber : String {required}
  - address : String {required}
  - contactPerson : String {required}
  - email : String {required}
  - phone : String {required}
  - website : String
