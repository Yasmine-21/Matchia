  - welcomeText : String
  - banniereUrl : String
  - footerText : String
  - logoImageUrl : String
  - totalMonthlyPrice : BigDecimal
  - status : MarketplaceStatusEnum <<ENUM>>
  - createdAt : LocalDateTime {created}
  .. Opérations métier ..
  + getBannerImageUrl(): String
  + setBannerImageUrl(url: String): void
}

' Interfaces/front : adhésion, demandes, renouvellement
class Request <<entity>> {
  - id : Long {id, generated} <<PK>>
