class PasswordResetToken <<entity>> {
  - id : Long {id, generated} <<PK>>
  - tokenHash : String {unique, required}
  - user : User [1] <<FK>>
  - createdAt : Instant {required, created}
  - expiresAt : Instant {required}
  - usedAt : Instant
  - ipAddress : String
  - userAgent : String
  .. Opérations métier ..
  + isUsable(): boolean
  .. Contraintes ..
