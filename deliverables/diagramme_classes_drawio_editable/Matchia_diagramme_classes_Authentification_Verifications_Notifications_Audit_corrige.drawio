        <mxCell id="entity-Dealer" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=11;fontColor=#172B4D;fillColor=#FFFFFF;gradientColor=#E8F1FA;strokeColor=#2F75B5;strokeWidth=1.8;shadow=0;gradientDirection=south;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;«entity»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Dealer&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− id : Long {id, generated}&lt;br&gt;− companyName : String {required}&lt;br&gt;− registrationNumber : String {required}&lt;br&gt;− address : String {required}&lt;br&gt;− contactPerson : String {required}&lt;br&gt;− email : String {required}&lt;br&gt;− phone : String {required}&lt;br&gt;− website : String&lt;br&gt;− logoUrl : String&lt;br&gt;− contactPhotoUrl : String&lt;br&gt;− store : Store [1]&lt;br&gt;− status : DealerStatusEnum {required}&lt;br&gt;− createdAt : LocalDateTime {created}&lt;br&gt;− updatedAt : LocalDateTime {updated}&lt;hr&gt;&lt;div style=&quot;font-size:9px;text-align:left&quot;&gt;&lt;b&gt;{contraintes}&lt;/b&gt;&lt;br&gt;unique(registrationNumber)&lt;br&gt;unique(email)&lt;/div&gt;&lt;/div&gt;" vertex="1">
