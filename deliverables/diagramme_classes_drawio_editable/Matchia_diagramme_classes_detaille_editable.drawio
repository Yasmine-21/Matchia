alMonthlyPrice : BigDecimal&lt;br&gt;− status : MarketplaceStatusEnum&lt;br&gt;− createdAt : LocalDateTime {created}&lt;hr&gt;+ getBannerImageUrl(): String&lt;br&gt;+ setBannerImageUrl(url: String): void&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=11;fontColor=#172B4D;fillColor=#FFFFFF;gradientColor=#DCEEFF;strokeColor=#2F75B5;strokeWidth=1.8;shadow=0;gradientDirection=south;" vertex="1" parent="1"><mxGeometry x="1850" y="150" width="330" height="323" as="geometry"/></mxCell><mxCell id="entity-Request" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;«entity»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Request&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− id : Long {id, generated}&lt;br&gt;− bank : Bank [0..1]&lt;br&gt;− requestType : RequestTypeEnum&lt;br&gt;− status : RequestStatusEnum&lt;br&gt;− priority : String&lt;br&gt;− rejectionReason : String&lt;br&gt;− createdBy : String&lt;br&gt;− bankName : String&lt;br&gt;− bankEmail : String&lt;br&gt;− bankPhone : String&lt;br&gt;− logoUrl : String&lt;br&gt;− country : String&lt;br&gt;− website : String&lt;br&gt;− contactName : String&lt;br&gt;− contactEmail : String&lt;br&gt;− contactPhone : String&lt;br&gt;− contactImageUrl : String&lt;br&gt;− description : String&lt;br&gt;− bankDescription : String&lt;br&gt;− establishmentYear : Integer&lt;br&gt;− marketplaceSlug : String&lt;br&gt;− marketplaceDescription : String&lt;br&gt;− primaryColor : String&lt;br&gt;− secondaryColor : String&lt;br&gt;− banniereUrl : String&lt;br&gt;− selectedStores : String&lt;br&gt;− selectedModules : String&lt;br&gt;− totalAmount : Double&lt;br&gt;− originalRequest : Request [0..1]&lt;br&gt;− subscription : Subscription [0..1]&lt;br&gt;− selectedStoreDetails : List&amp;lt;RequestStoreSelection&amp;gt; [0..*]&lt;br&gt;− stores : List&amp;lt;Store&amp;gt; [0..*]&lt;br&gt;− modules : List&amp;lt;Module&a