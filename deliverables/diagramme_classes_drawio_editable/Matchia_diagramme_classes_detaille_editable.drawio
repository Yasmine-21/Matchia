height="24" as="geometry"/></mxCell><mxCell id="legend82" value="" style="strokeColor=#44546A;strokeWidth=2;startArrow=diamond;startFill=1;endArrow=none;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="2633" as="sourcePoint"/><mxPoint x="170" y="2633" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t83" value="Composition / cycle de vie" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="185" y="2619" width="270" height="24" as="geometry"/></mxCell><mxCell id="legend84" value="" style="strokeColor=#7F7F7F;strokeWidth=1.5;dashed=1;dashPattern=6 4;endArrow=none;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="2663" as="sourcePoint"/><mxPoint x="170" y="2663" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t85" value="Référence logique sans FK" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="185" y="2649" width="270" height="24" as="geometry"/></mxCell><mxCell id="t86" value="Chaque classe et chaque connecteur reste modifiable dans draw.io / diagrams.net. Les cardinalités proviennent des mappings JPA; les traits pointillés indiquent des identifiants stockés sans association JPA." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=10;fontColor=#50657A;align=right;" vertex="1" parent="1"><mxGeometry x="660" y="2604" width="2880" height="54" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="client-financing" name="06 - Financement client"><mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="1900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2" value="Client, simulation et traitement d’une demande de financement" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontStyle=1;fontColor=#1F4E79;align=center;" vertex="1" parent="1"><mxGeometry x="45" y="18" width="2910" height="38" as="geometry"/></mxCell><mxCell id="t3" value="Interfaces couvertes: Simulator, ClientRegistration, ClientArea, FinancingManagement et DealerFinancingRequests. Deux sources de produit sont possibles: Product ou DealerProduct." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#334155;align=center;" vertex="1" parent="1"><mxGeometry x="80" y="58" width="2840" height="42" as="geometry"/></mxCell><mxCell id="entity-User" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;«entity»&lt;/span&gt;&lt;br&gt;&lt;b&gt;User&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− id : Long {id, generated}&lt;br&gt;− bank : Bank [0..1]&lt;br&gt;− dealer : Dealer [0..1]&lt;br&gt;− fullName : String&lt;br&gt;− email : String&lt;br&gt;− phone : String&lt;br&gt;− address : String&lt;br&gt;− contactImageUrl : String&lt;br&gt;− birthDate : LocalDate&lt;br&gt;− role : RoleEnum&lt;br&gt;− status : UserStatusEnum&lt;br&gt;− password : String&lt;br&gt;− createdAt : LocalDateTime {created}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=11;fontColor=#172B4D;fillColor=#FFFFFF;gradientColor=#DCEEFF;strokeColor=#2F75B5;strokeWidth=1.8;shadow=0;gradientDirection=south;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="330" height="263" as="geometry"/></mxCell><mxCell id="entity-Bank" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;«entity»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Bank&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− id : Long {id, generated}&lt;br&gt;− marketplace : Marketplace [0..1]&lt;br&gt;− users : List&amp;lt;User&amp;gt; [0..*]&lt;br&gt;− requests : List&amp;lt;Request&amp;gt; [0..*]&lt;br&gt;− name : String&lt;br&gt;− slug : String&lt;br&gt;− email : String&lt;br&gt;− phone : String&lt;br&gt;− logoText : String&lt;br&gt;− logoUrl : String&lt;br&gt;− country : String&lt;br&gt;− description : String&lt;br&gt;− websiteUrl : String&lt;br&gt;− establishedYear : Integer&lt;br&gt;− status : BankStatusEnum&lt;br&gt;− totalUsers : Integer&lt;br&gt;− createdAt : LocalDateTime {created}&lt;br&gt;− updatedAt : LocalDateTime {updated}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=11;fontColor=#172B4D;fillColor=#FFFFFF;gradientColor=#DCEEFF;strokeColor=#2F75B5;strokeWidth=1.8;shadow=0;gradientDirection=south;" vertex="1" parent="1"><mxGeometry x="430" y="140" width="330" height="338" as="geometry"/></mxCell><mxCell id="entity-Store" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;«entity»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Store&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− id : Long {id, generated}&lt;br&gt;− marketplaceStores : List&amp;lt;MarketplaceStore&amp;gt; [0..*]&lt;br&gt;− moduleStores : List&amp;lt;ModuleStore&amp;gt; [0..*]&lt;br&gt;− contents : List&amp;lt;Content&amp;gt; [0..*]&lt;br&gt;− marketplaceContents : List&amp;lt;MarketplaceContent&amp;gt; [0..*]&lt;br&gt;− name : String&lt;br&gt;− description : String&lt;br&gt;− icon : String&lt;br&gt;− banniereUrl : String&lt;br&gt;− price : BigDecimal&lt;br&gt;− status : StoreStatusEnum&lt;br&gt;− createdAt : LocalDateTime {created}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=11;fontColor=#172B4D;fillColor=#FFFFFF;gradientColor=#DCEEFF;strokeColor=#2F75B5;strokeWidth=1.8;shadow=0;gradientDirection=south;" vertex="1" parent="1"><mxGeo