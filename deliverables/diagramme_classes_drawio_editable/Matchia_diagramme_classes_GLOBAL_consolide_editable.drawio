        </mxCell>
        <mxCell id="g-note-requirements" parent="1" vertex="1" value="&lt;b&gt;«configuration technique»&lt;/b&gt;&lt;br&gt;RequiredFinancingDocument personnalise les pièces par banque/store. Sans configuration, le service utilise une liste codée par défaut." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=11;fontColor=#4A3A00;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;">
          <mxGeometry x="5750" y="2850" width="620" height="125" as="geometry" />
        </mxCell>
        <mxCell id="g-note-security" parent="1" vertex="1" value="&lt;b&gt;«workflow sans FK»&lt;/b&gt;&lt;br&gt;JoinEmailVerification est consommé avant la création d’une Request; ClientRegistrationVerification crée ensuite un User sans conserver de user_id." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=11;fontColor=#4A3A00;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;">
