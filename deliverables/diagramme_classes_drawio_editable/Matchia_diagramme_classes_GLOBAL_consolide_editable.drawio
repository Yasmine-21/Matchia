        <mxCell id="g-note-finance" parent="1" vertex="1" value="&lt;b&gt;«constraint»&lt;/b&gt;&lt;br&gt;{ FinancingRequest.dealerProduct != null }&lt;br&gt;DealerProduct est la seule source fonctionnelle retenue pour le financement." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=11;fontColor=#4A3A00;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;">
