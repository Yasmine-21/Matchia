        <mxCell id="note-audit-resource" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=11;fontColor=#4A3A00;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;" value="&lt;b&gt;«référence polymorphe»&lt;/b&gt;&lt;br&gt;AuditLog.resourceType + resourceId peut viser plusieurs types d’entités. Il ne s’agit pas d’une clé étrangère vers Request." vertex="1">
