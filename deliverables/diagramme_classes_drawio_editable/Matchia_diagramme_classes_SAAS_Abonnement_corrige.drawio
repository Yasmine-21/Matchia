FF;strokeColor=#2F75B5;strokeWidth=1.8;shadow=0;gradientDirection=south;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="350" height="263" as="geometry"/></mxCell><mxCell id="entity-Bank" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;«entity»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Bank&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− id : Long {id, generated}&lt;br&gt;− marketplace : Marketplace [0..1]&lt;br&gt;− users : List&amp;lt;User&amp;gt; [0..*]&lt;br&gt;− requests : List&amp;lt;Request&amp;gt; [0..*]&lt;br&gt;− name : String&lt;br&gt;− slug : String&lt;br&gt;− email : String&lt;br&gt;− phone : String&lt;br&gt;− logoText : String&lt;br&gt;− logoUrl : String&lt;br&gt;− country : String&lt;br&gt;− description : String&lt;br&gt;− websiteUrl : String&lt;br&gt;− establishedYear : Integer&lt;br&gt;− status : BankStatusEnum&lt;br&gt;− totalUsers : Integer&lt;br&gt;− createdAt : LocalDateTime {created}&lt;br&gt;− updatedAt : LocalDateTime {updated}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=11;fontColor=#172B4D;fillColor=#FFFFFF;gradientColor=#DCEEFF;strokeColor=#2F75B5;strokeWidth=1.8;shadow=0;gradientDirection=south;" vertex="1" parent="1"><mxGeometry x="500" y="610" width="360" height="338" as="geometry"/></mxCell><mxCell id="entity-Marketplace" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;«entity»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Marketplace&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− id : Long {id, generated}&lt;br&gt;− bank : Bank [1] {unique}&lt;br&gt;− marketplaceStores : List&amp;lt;MarketplaceStore&amp;gt; [0..*]&lt;br&gt;− marketplaceContents : List&amp;lt;MarketplaceContent&amp;gt; [0..*]&lt;br&gt;− primaryColor : String&lt;br&gt;− secondaryColor : String&lt;br&gt;− homepageTitle : String&lt;br&gt;− welcomeText : String&lt;br&gt;− banniereUrl : String&lt;br&gt;− footerText : String&lt;br&gt;− logoImageUrl : String&lt;br&gt;− totalMonthlyPrice : BigDecimal&lt;br&gt;− status : MarketplaceStatusEnum&lt;br&gt;− createdAt : LocalDateTime {created}&lt;hr&gt;+ getBannerImageUrl(): String&lt;br&gt;+ setBannerImageUrl(url: String): void&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=11;fontColor=#172B4D;fillColor=#FFFFFF;gradientColor=#DCEEFF;strokeColor=#2F75B5;strokeWidth=1.8;shadow=0;gradientDirection=south;" vertex="1" parent="1"><mxGeometry x="500" y="1120" width="360" height="323" as="geometry"/></mxCell><mxCell id="entity-Request" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;«entity»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Request&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− id : Long {id, generated}&lt;br&gt;− bank : Bank [0..1]&lt;br&gt;− requestType : RequestTypeEnum&lt;br&gt;− status : RequestStatusEnum&lt;br&gt;− priority : String&lt;br&gt;− rejectionReason : String&lt;br&gt;− createdBy : String&lt;br&gt;− bankName : String&lt;br&gt;− bankEmail : String&lt;br&gt;− bankPhone : String&lt;br&gt;− logoUrl : String&lt;br&gt;− country : String&lt;br&gt;− website : String&lt;br&gt;− contactName : String&lt;br&gt;− contactEmail : String&lt;br&gt;− contactPhone : String&lt;br&gt;− contactImageUrl : String&lt;br&gt;− description : String&lt;br&gt;− bankDescription : String&lt;br&gt;− establishmentYear : Integer&lt;br&gt;− marketplaceSlug : String&lt;br&gt;− marketplaceDescription : String&lt;br&gt;− primaryColor : String&lt;br&gt;− secondaryColor : String&lt;br&gt;− banniereUrl : String&lt;br&gt;− selectedStores : String&lt;br&gt;− selectedModules : String&lt;br&gt;− totalAmount : Double&lt;br&gt;− originalRequest : Request [0..1]&lt;br&gt;− subscription : Subscription [0..1]&lt;br&gt;− selectedStoreDetails : List&amp;lt;RequestStoreSelection&amp;gt; [0..*]&lt;br&gt;− stores : List&amp;lt;Store&amp;gt; [0..*]&lt;br&gt;− modules : List&amp;lt;Module&amp;gt; [0..*]&lt;br&gt;− createdAt : LocalDateTime {created}&lt;br&gt;− updatedAt : LocalDateTime {updated}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=11;fontColor=#172B4D;fillColor=#D9ECFF;gradientColor=#B7D8F5;strokeColor=#1F4E79;strokeWidth=2.6;shadow=1;gradientDirection=south;" vertex="1" parent="1"><mxGeometry x="1080" y="650" width="440" height="593" as="geometry"/></mxCell><mxCell id="entity-Store" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;«entity»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Store&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− id : Long {id, generated}&lt;br&gt;− marketplaceStores : List&amp;lt;MarketplaceStore&amp;gt; [0..*]&lt;br&gt;− moduleStores : List&amp;lt;ModuleStore&amp;gt; [0..*]&lt;br&gt;− contents : List&amp;lt;Content&amp;gt; [0..*]&lt;br&gt;− marketplaceContents : List&amp;lt;MarketplaceContent&amp;gt; [0..*]&lt;br&gt;− name : String&lt;br&gt;− description : String&lt;br&gt;− icon : String&lt;br&gt;− banniereUrl : String&lt;br&gt;− price : BigDecimal&lt;br&gt;− status : StoreStatusEnum&lt;br&gt;− createdAt : LocalDateTime {created}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=11;fontColor=#172B4D;fillColor=#FFFFFF;gradientColor=#DCEEFF;strokeColor=#2F75B5;strokeWidth=1.8;shadow=0;gradientDirection=south;" vertex="1" parent="1"><mxGeometry x="1790" y="170" width="350" height="248" as="geometry"/></mxCell><mxCell id="entity-Module" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;«entity»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Module&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− id : Long {id, generated}&lt;br&gt;− marketplaceStoreModules : List&amp;lt;MarketplaceStoreModule&amp;gt; [0..*]&lt;br&gt;− moduleStores : List&amp;lt;ModuleStore&amp;gt; [0..*]&lt;br&gt;− name : String&lt;br&gt;− description : String&lt;br&gt;− icon : String&lt;br&gt;− category : String&lt;br&gt;− price : BigDecimal&lt;br&gt;− status : ModuleStatusEnum&lt;br&gt;− createdAt : LocalDateTime {created}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=11;fontColor=#172B4D;fillColor=#FFFFFF;gradientColor=#DCEEFF;strokeColor=#2F75B5;strokeWidth=1.8;shadow=0;gradientDirection=south;" vertex="1" parent="1"><mxGeometry x="2250" y="170" width="350" height="218" as="geometry"/></mxCell><mxCell id="entity-RequestStoreSelection" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;«entity»&lt;/span&gt;&lt;br&gt;&lt;b&gt;RequestStoreSelection&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− id : Long {id, generated}&lt;br&gt;− request : Request [1]&lt;br&gt;− storeId : Long&lt;br&gt;− storeName : String&lt;br&gt;− storeDescription : String&lt;br&gt;− storePrice : BigDecimal&lt;br&gt;− modules : List&amp;lt;RequestModuleSelection&amp;gt; [0..*]&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=11;fontColor=#172B4D;fillColor=#FFFFFF;gradientColor=#DCEEFF;strokeColor=#2F75B5;strokeWidth=1.8;shadow=0;gradientDirection=south;" vertex="1" parent="1"><mxGeometry x="1790" y="650" width="360" height="173" as="geometry"/></mxCell><mxCell id="entity-RequestModuleSelection" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;«entity»&lt;/span&gt;&lt;br&gt;&lt;b&gt;RequestModuleSelection&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− id : Long {id, generated}&lt;br&gt;− requestStore : RequestStoreSelection [1]&lt;br&gt;− moduleId : Long&lt;br&gt;− moduleName : String&lt;br&gt;− moduleDescription : String&lt;br&gt;− modulePrice : BigDecimal&lt;br&gt;− parameters : String&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=11;fontColor=#172B4D;fillColor=#FFFFFF;gradientColor=#DCEEFF;strokeColor=#2F75B5;strokeWidth=1.8;shadow=0;gradientDirection=south;" vertex="1" parent="1"><mxGeometry x="2250" y="650" width="370" height="173" as="geometry"/></mxCell><mxCell id="entity-Subscription" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;«entity»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Subscription&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− id : Long {id, generated}&lt;br&gt;− request : Request [1] {unique}&lt;br&gt;− marketplace : Marketplace [1]&lt;br&gt;− status : SubscriptionStatusEnum {required}&lt;br&gt;− startDate : LocalDate&lt;br&gt;− expirationDate : LocalDate&lt;br&gt;− renewalReminderSentAt : LocalDateTime&lt;br&gt;− durationMonths : Integer {required}&lt;br&gt;− payments : List&amp;lt;Payment&amp;gt; [0..*]&lt;br&gt;− createdAt : LocalDateTime {created}&lt;br&gt;− updatedAt : LocalDateTime {updated}&lt;hr&gt;&lt;div style=&quot;font-size:9px;text-align:left&quot;&gt;&lt;b&gt;{contraintes}&lt;/b&gt;&lt;br&gt;unique(request)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=11;fontColor=#172B4D;fillColor=#FFFFFF;gradientColor=#DCEEFF;strokeColor=#2F75B5;strokeWidth=1.8;shadow=0;gradientDirection=south;" vertex="1" parent="1"><mxGeometry x="1110" y="1430" width="400" height="263" as="geometry"/></mxCell><mxCell id="entity-Payment" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;«entity»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Payment&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− id : Long {id, generated}&lt;br&gt;− request : Request [1]&lt;br&gt;− subscription : Subscription [0..1]&lt;br&gt;− renewalRequest : Request [0..1]&lt;br&gt;− stripeSessionId : String {unique}&lt;br&gt;− stripePaymentIntentId : String&lt;br&gt;− amount : BigDecimal {required}&lt;br&gt;− currency : String {required}&lt;br&gt;− status : PaymentStatusEnum {required}&lt;br&gt;− paymentType : PaymentTypeEnum {required}&lt;br&gt;− renewedPayment : Payment [0..1]&lt;br&gt;− checkoutUrl : String&lt;br&gt;− bankName : String&lt;br&gt;− createdAt : LocalDateTime {created}&lt;br&gt;− updatedAt : LocalDateTime {updated}&lt;br&gt;− paidAt : LocalDateTime&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=11;fontColor=#172B4D;fillColor=#FFFFFF;gradientColor=#DCEEFF;strokeColor=#2F75B5;strokeWidth=1.8;shadow=0;gradientDirection=south;" vertex="1" parent="1"><mxGeometry x="1740" y="1510" width="390" height="308" as="geometry"/></mxCell><mxCell id="entity-Notification" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;«entity»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Notification&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;− id : Long {id, generated}&lt;br&gt;− title : String {required}&lt;br&gt;− message : String {required}&lt;br&gt;− type : NotificationTypeEnum {required}&lt;br&gt;− status : NotificationStatusEnum {required}&lt;br&gt;− relatedRequestId : Long&lt;br&gt;− recipientId : Long&lt;br&gt;− recipientScope : NotificationRecipientScope&lt;br&gt;− createdAt : LocalDateTime {required, created}&lt;br&gt;− readAt : LocalDateTime&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;fontFamily=Arial;fontSize=11;fontColor=#172B4D;fillColor=#FFFFFF;gradientColor=#DCEEFF;strokeColor=#2F75B5;strokeWidth=1.8;shadow=0;gradientDirection=south;" vertex="1" parent="1"><mxGeometry x="60" y="1260" width="350" height="218" as="geometry"/></mxCell><mxCell id="enti