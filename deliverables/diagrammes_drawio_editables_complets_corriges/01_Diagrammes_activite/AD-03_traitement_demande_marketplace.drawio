r la demande" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#f2f6fb;strokeColor=#2f75b5;strokeWidth=3;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#17365d;" vertex="1" parent="1"><mxGeometry x="160" y="780" width="700" height="84" as="geometry"/></mxCell><mxCell id="checkout" value="Créer une session de paiement sécurisée Stripe" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#f2f6fb;strokeColor=#2f75b5;strokeWidth=3;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#17365d;" vertex="1" parent="1"><mxGeometry x="160" y="895" width="700" height="84" as="geometry"/></mxCell><mxCell id="sendLink" value="Envoyer le lien et les instructions de paiement" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#f2f6fb;strokeColor=#2f75b5;strokeWidth=3;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#17365d;" vertex="1" parent="1"><mxGeometry x="160" y="1010" width="700" height="84" as="geometry"/></mxCell><mxCell id="pay" value="Le futur Administrateur Banque effectue le paiement sur Stripe" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#f2f6fb;strokeColor=#2f75b5;strokeWidth=3;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#17365d;" vertex="1" parent="1"><mxGeometry x="160" y="1125" width="700" height="84" as="geometry"/></mxCell><mxCell id="paid" value="Paiement Stripe&lt;br&gt;confirmé ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#2f75b5;strokeWidth=3;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#17365d;" vertex="1" parent="1"><mxGeometry x="305" y="1222" width="410" height="120" as="geometry"/></mxCell><mxCell id="paymentError" value="Signaler l'échec ou l'expiration et proposer un nouvel essai" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#fde9e7;strokeColor=#2f75b5;strokeWidth=3;fontFamily=Arial;fontSize=18;fontStyle=1;fontColor=#17365d;" vertex="1" parent="1"><mxGeometry x="860" y="1240" width="600" height="84" as="geometry"/></mxCell><mxCell id="webhook" v